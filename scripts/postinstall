#!/bin/sh
# Apple Silicon Printer Drivers — post-install
#  1. retire vendor Intel-only driver bits that block Apple's generic USB class driver
#  2. auto-detect USB printers and create queues for supported models
set -u
GP=/Library/Printers/Gutenprint
B="/Users/Shared/printer-driver-backup"
NEED_REBOOT=0
log() { echo "[printer-drivers] $*"; }

chown -R root:wheel "$GP"; chmod -R u=rwX,go=rX "$GP"
mkdir -p /usr/local/bin && ln -sf "$GP/bin/gutenprint-add" /usr/local/bin/gutenprint-add

# ---- 1) Canon IJ driver (Intel-only). Its codeless kext pins Canon's x86_64 USB class-driver
#         plugin to the printer, which stops macOS from using its own generic driver.
if [ -d /Library/Extensions/BJUSBLoad.kext ]; then
  mkdir -p "$B"
  kmutil unload -b jp.co.canon.bj.print.BJUSBLoad >/dev/null 2>&1 || true
  mv /Library/Extensions/BJUSBLoad.kext "$B/" && log "moved Canon BJUSBLoad.kext -> $B"
  kmutil install --update-all >/dev/null 2>&1 || true
  NEED_REBOOT=1
fi
if [ -d /Library/Printers/Canon/BJPrinter ]; then
  mkdir -p "$B"; mv /Library/Printers/Canon "$B/Canon" && log "moved /Library/Printers/Canon -> $B"
fi
for p in /Library/Printers/PPDs/Contents/Resources/CanonIJ*.ppd.gz; do
  [ -f "$p" ] && mkdir -p "$B" && mv "$p" "$B/" && log "moved $(basename "$p") -> $B"
done
rm -rf /Library/Caches/Canon
# queues that still point at the Canon IJ filters can never print again
for f in /etc/cups/ppd/*.ppd; do
  [ -f "$f" ] || continue; q=$(basename "$f" .ppd)
  if grep -qs 'Raster2CanonIJ' "$f"; then
    lpadmin -x "$q" && log "removed dead Canon queue: $q"
  fi
done

# ---- 2) auto-detect USB printers
#  lpinfo -v prints: direct usb://Vendor/Model%20name?serial=XXX
#  Match through the helper so Gutenprint and brlaser use the same catalog.
lpinfo -v 2>/dev/null | awk '$2 ~ /^usb:\/\//{print $2}' | while read -r URI; do
  DEV=$(printf '%s' "$URI" | sed -E 's#^usb://##; s#\?.*##; s#%20# #g; s#/# #')
  ID=$("$GP/bin/gutenprint-add" --match-usb "$URI")
  if [ -n "$ID" ]; then
    QUEUE=$(printf '%s' "$DEV" | tr -c 'A-Za-z0-9\n' '_' | sed -E 's/_+/_/g; s/^_//; s/_$//')
    if "$GP/bin/gutenprint-add" "$ID" "$QUEUE" "$URI" >/dev/null 2>&1; then
      lpadmin -d "$QUEUE" 2>/dev/null || true
      log "queue '$QUEUE' created for '$DEV' ($ID) and set as default"
    else
      log "could not create queue for '$DEV'"
    fi
  else
    log "USB printer '$DEV' not matched automatically — run: gutenprint-add --list \"<model>\"  then: sudo gutenprint-add <id>"
  fi
done
[ "$(lpinfo -v 2>/dev/null | grep -c '^direct usb://')" = 0 ] && log "no USB printer connected — connect one and run: sudo gutenprint-add <id>  (find <id> with: gutenprint-add --list \"<model>\")"

[ "$NEED_REBOOT" = 1 ] && log "REBOOT REQUIRED (vendor kernel extension removed) — then unplug/replug the printer once."
exit 0
