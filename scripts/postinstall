#!/bin/sh
# Gutenprint MP250 (arm64) — post-install: retire Canon's Intel-only driver, create the queue.
set -u
B="/Users/Shared/canon-mp250-backup"
NEED_REBOOT=0
log() { echo "[mp250-arm] $*"; }

# 1) Canon's codeless kext pins its x86_64 USB class driver to the printer -> generic driver can't be used
if [ -d /Library/Extensions/BJUSBLoad.kext ]; then
  mkdir -p "$B"
  kmutil unload -b jp.co.canon.bj.print.BJUSBLoad >/dev/null 2>&1 || true
  mv /Library/Extensions/BJUSBLoad.kext "$B/" && log "moved BJUSBLoad.kext -> $B"
  kmutil install --update-all >/dev/null 2>&1 || true
  NEED_REBOOT=1
fi

# 2) Canon IJ driver tree (x86_64 filters + USB class driver plugin) and its PPD
if [ -d /Library/Printers/Canon/BJPrinter ]; then
  mkdir -p "$B"
  mv /Library/Printers/Canon "$B/Canon" && log "moved /Library/Printers/Canon -> $B"
fi
for p in /Library/Printers/PPDs/Contents/Resources/CanonIJMP250series.ppd.gz; do
  [ -f "$p" ] && mkdir -p "$B" && mv "$p" "$B/" && log "moved $(basename "$p") -> $B"
done
rm -rf /Library/Caches/Canon

# 3) drop queues that still point at the Canon PPD
for q in $(lpstat -p 2>/dev/null | awk '{print $2}'); do
  if grep -qs 'Raster2CanonIJ' "/etc/cups/ppd/$q.ppd" 2>/dev/null; then
    lpadmin -x "$q" && log "removed old Canon queue: $q"
  fi
done

# 4) create / refresh the Gutenprint queue if the printer is connected
lpadmin -x Canon_MP250_Gutenprint 2>/dev/null && log "replacing manual queue Canon_MP250_Gutenprint with Canon_MP250"
PPD=/Library/Printers/PPDs/Contents/Resources/Gutenprint-Canon-MP250.ppd
chmod 644 "$PPD"; chown -R root:wheel /Library/Printers/Gutenprint; chmod -R u=rwX,go=rX /Library/Printers/Gutenprint
URI=$(lpinfo -v 2>/dev/null | awk '/usb:\/\/Canon\/MP250/{print $2; exit}')
if [ -n "$URI" ]; then
  lpadmin -p Canon_MP250 -E -v "$URI" -P "$PPD" -D "Canon MP250 (Gutenprint)" -o printer-is-shared=false 2>&1 | grep -v 'deprecated\|kullanımdan' || true
  cupsenable Canon_MP250 2>/dev/null; cupsaccept Canon_MP250 2>/dev/null
  lpadmin -d Canon_MP250 2>/dev/null || true
  log "queue Canon_MP250 ready ($URI)"
else
  log "printer not detected over USB — connect it and add it in System Settings > Printers,"
  log "choosing 'Canon MP250 series - CUPS+Gutenprint v5.3.4' under Select Software."
fi

[ "$NEED_REBOOT" = 1 ] && log "REBOOT REQUIRED (kernel extension removed) — then unplug/replug the printer once."
exit 0
