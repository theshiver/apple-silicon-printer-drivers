#!/bin/sh
# Shares the printers on this Mac with iPhones and iPads over AirPrint.
# Off until someone turns it on. Runs per user, as one LaunchAgent per printer, while that user is logged in.
#   airprint-share list          printers that can be shared
#   airprint-share shared        printers shared right now
#   airprint-share info          queue, name, shared, reachable: one tab-separated line per printer
#   airprint-share set [q ...]   share exactly these queues; no queues turns sharing off
set -u
GP=/Library/Printers/Gutenprint
PPDS=/etc/cups/ppd
EVE=/usr/bin/ippeveprinter
FIRST_PORT=8631
LABEL=com.github.apple-silicon-printer-drivers.airprint
AGENTS="$HOME/Library/LaunchAgents"
SPOOL="$HOME/Library/Caches/$LABEL"
DOMAIN="gui/$(id -u)"

# Every queue on this Mac, except one made from our own "<name> (Mac)" announcement: sharing that would loop.
# LC_ALL=C because lpstat translates the word "printer".
printers() {
  LC_ALL=C lpstat -p 2>/dev/null | awk '$1 == "printer" { print $2 }' | grep -v '__Mac_$'
  return 0
}

# The name people know from System Settings
title() {
  d=$(LC_ALL=C lpstat -l -p "$1" 2>/dev/null | sed -n 's/^[[:space:]]*Description: //p' | sed 's/ - Apple Silicon$//' | head -1)
  [ -n "$d" ] && echo "$d" || echo "$1" | tr '_' ' '
}

# 1 if this Mac can reach the printer now, as far as it can tell
reachable() {
  uri=$(LC_ALL=C lpstat -v "$1" 2>/dev/null | sed 's/^device for [^:]*: //')
  case "$uri" in
    usb:*) if lpoptions -p "$1" 2>/dev/null | grep -q offline-report; then echo 0; else echo 1; fi; return ;;
    ipp://*|ipps://*|http://*|https://*) port=631 ;;
    socket://*) port=9100 ;;
    lpd://*) port=515 ;;
    *) echo 1; return ;;
  esac
  hp=${uri#*://}; hp=${hp%%/*}; hp=${hp%%\?*}; host=${hp%%:*}
  case "$hp" in *:*) port=${hp##*:} ;; esac
  if nc -z -G 1 "$host" "$port" >/dev/null 2>&1; then echo 1; else echo 0; fi
}

shared() {
  for f in "$AGENTS/$LABEL".*.plist; do
    [ -f "$f" ] || continue
    q=${f##*/}; q=${q%.plist}; echo "${q#"$LABEL."}"
  done
}

stop() {
  q=$1
  launchctl bootout "$DOMAIN/$LABEL.$q" >/dev/null 2>&1
  rm -f "${AGENTS:?}/${LABEL:?}.${q:?}.plist"
}

free_port() {
  p=$FIRST_PORT
  while grep -qs "<string>$p</string>" "$AGENTS/$LABEL".*.plist; do p=$((p + 1)); done
  echo "$p"
}

start() {
  q=$1; port=$(free_port); plist="$AGENTS/$LABEL.$q.plist"; ppd="$PPDS/$q.ppd"
  # two speeds announce a color printer; a queue without a PPD counts as color, CUPS handles the rest
  speed=10,5; grep -qs '^\*ColorDevice:[[:space:]]*False' "$ppd" && speed=10
  duplex=; grep -qs '^\*OpenUI \*Duplex' "$ppd" && duplex='<string>-2</string>'
  mkdir -p "$AGENTS" "$SPOOL/$q"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$LABEL.$q</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>EnvironmentVariables</key><dict><key>AIRPRINT_QUEUE</key><string>$q</string></dict>
<key>ProgramArguments</key><array>
<string>$EVE</string><string>-c</string><string>$GP/bin/airprint-forward</string>
<string>-d</string><string>$SPOOL/$q</string>
<string>-f</string><string>application/pdf,image/jpeg,image/urf</string>
<string>-p</string><string>$port</string>
<string>-r</string><string>_universal</string>
<string>-s</string><string>$speed</string>$duplex
<string>$(title "$q" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g') (Mac)</string>
</array>
</dict></plist>
PLIST
  launchctl bootstrap "$DOMAIN" "$plist"
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case "$cmd" in
  list) printers ;;
  shared) shared ;;
  info)
    on=$(shared)
    for q in $(printers); do
      s=0; echo "$on" | grep -qxF -- "$q" && s=1
      printf '%s\t%s\t%s\t%s\n' "$q" "$(title "$q")" "$s" "$(reachable "$q")"
    done
    ;;
  set)
    known=$(printers)
    for q in "$@"; do
      echo "$known" | grep -qxF -- "$q" || { echo "no such printer: $q" >&2; exit 1; }
    done
    for s in $(shared); do
      keep=0; for w in "$@"; do [ "$w" = "$s" ] && keep=1; done
      [ "$keep" = 1 ] || stop "$s"
    done
    running=$(shared)
    for w in "$@"; do
      echo "$running" | grep -qxF -- "$w" || start "$w"
    done
    ;;
  *) echo "usage: airprint-share list | shared | info | set [queue ...]" >&2; exit 2 ;;
esac
